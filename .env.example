# OpenAI / LLM
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-large

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5001
PORT=5001
LOG_LEVEL=INFO

# Vector Backend Toggle: chroma | pinecone
VECTOR_BACKEND=chroma

# Chroma (lokal)
CHROMA_DB_PATH=./data/vectorstore
COLLECTION_NAME=actuarial_documents

# Pinecone (serverless)
# Wajib: dapatkan API Key dari Pinecone Console
PINECONE_API_KEY=your_pinecone_api_key_here
# Wajib: nama index Pinecone (buat di console atau via code)
PINECONE_INDEX_NAME=aktuaria-docs
# Opsional: namespace untuk memisahkan koleksi
PINECONE_NAMESPACE=default
# Serverless spesifikasi saat membuat index (disarankan di env untuk konsistensi)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Harus sesuai dengan dimensi model embedding
# text-embedding-3-large -> 3072, text-embedding-3-small -> 1536
PINECONE_DIMENSION=3072
PINECONE_METRIC=cosine

# Document Processing
CHUNK_SIZE=800
CHUNK_OVERLAP=200